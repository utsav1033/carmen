# Copy to .env and fill in. carmen loads it automatically; real env vars take precedence.

# Option A: an Anthropic key, or a proxy key used the same way
ANTHROPIC_API_KEY=
# Set this if your key belongs to a proxy (e.g. LiteLLM) that speaks the Anthropic API
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# Option B: through a LiteLLM proxy (if LITELLM_API_KEY is set, it's used instead of A)
# LITELLM_API_KEY=
# LITELLM_BASE_URL=http://localhost:4000

# Set to 0 if your proxy strips structured outputs
# CARMEN_STRUCTURED=1
